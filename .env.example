# Copy to .env.local and fill in. Never commit .env.local.

# Ticketmaster Discovery API key (free at developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Affiliate link templates. {url} is replaced with the encoded partner URL.
# Use the deep-link format your affiliate network (Impact, etc.) gives you after approval.
# Until approved, leave blank and the site links straight to the partner.
AFFILIATE_TEMPLATE_TICKETMASTER=
AFFILIATE_TEMPLATE_SEATGEEK=
AFFILIATE_TEMPLATE_VIVIDSEATS=

# Public site URL, used for links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox. Prefer a SERVER-ONLY token in MAPBOX_ACCESS_TOKEN: the API routes use it first.
# NEXT_PUBLIC_ variables are shipped to every browser, so if you set one, restrict that
# token by URL in the Mapbox dashboard. The server falls back to it if the first is empty.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: Google Maps Platform key for attraction (POI) search.
GOOGLE_MAPS_API_KEY=

# Optional: Amadeus credentials for flight search (not wired into the UI yet).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Optional: PassKit credentials for ticket delivery (not used by default).
PASSKIT_CLIENT_ID=
PASSKIT_CLIENT_SECRET=
AFFILIATE_TEMPLATE_PASSKIT=

